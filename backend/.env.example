# --- Server -------------------------------------------------------------
APP_NAME="BuildSync AI"
ENVIRONMENT=development
API_PREFIX=/api

# --- Database -----------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=buildsync

# --- Auth ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-your-local-env-file
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- CORS ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- File storage (local development) -----------------------------------
STORAGE_DIR=storage

# --- AI layer -----------------------------------------------------------
# Leave LLM_PROVIDER empty to run the deterministic local intelligence engine.
# Set to "anthropic" or "openai" and supply a key to enable a hosted model.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
